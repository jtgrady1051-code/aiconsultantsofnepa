# .env.example — safe to commit. Placeholders only, never real values.
# Copy to .env for local testing with `vercel dev`. .env must be in .gitignore.

# Anthropic API key — Tier 2 secret. Server-side only, never in frontend code.
# Get it at console.anthropic.com -> API Keys. Format: sk-ant-...
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Resend API key — Tier 2 secret. Sends the lead email when an assessment
# completes. Get it at resend.com -> API Keys. Format: re_...
RESEND_API_KEY=your-resend-api-key-here

# Where completed assessments get emailed.
LEAD_EMAIL=you@example.com
